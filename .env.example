# Copiar a .env y reemplazar los placeholders por valores aleatorios fuertes.
DB_NAME=librosbuysan
# No usar "postgres" ni "root".
DB_USER=
# Generar con: openssl rand -hex 32
DB_PASSWORD=
# Generar con: openssl rand -base64 48  (minimo 32 bytes decodificado)
JWT_SECRET=
# Generar con: openssl rand -base64 48  (minimo 32 bytes decodificado)
CORS_SECRET=
# Puerto del HOST para conectarse a Postgres desde fuera de Docker (ej.
# DBeaver). Opcional: si no se define, docker-compose usa 5445. Cambialo si
# ese puerto tambien esta ocupado en tu maquina.
DB_PORT=5445